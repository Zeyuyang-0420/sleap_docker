# Existing host directory mounted read/write at /data.
# Ubuntu example: /srv/sleap-data
# WSL2 example: /home/your-user/sleap-data (fastest) or /mnt/c/Users/you/sleap-data
DATA_DIR=./data

# Generate secrets with: openssl rand -hex 24
# Classic VNC authentication uses only the first 8 characters of its password.
VNC_PASSWORD=
JUPYTER_TOKEN=

# noVNC stays on a fixed localhost-only port. Jupyter prefers the first free
# port in its localhost-only range, so it normally receives 8899.
NOVNC_PORT=6080
JUPYTER_PORT_RANGE=8899-8999

DISPLAY_WIDTH=1920
DISPLAY_HEIGHT=1080
SHM_SIZE=8gb
GPU_COUNT=1

# Match the owner of DATA_DIR on native Linux. UID/GID 1000 is typical for WSL2.
USER_UID=1000
USER_GID=1000

IMAGE_NAME=sleap-gpu
IMAGE_TAG=1.6.5-cu118
# build: build locally from Dockerfile; pull: pull IMAGE_NAME:IMAGE_TAG and
# start it with --no-build.
SLEAP_IMAGE_MODE=build
COMPOSE_PROJECT_NAME=sleap
UV_VERSION=0.8.15
